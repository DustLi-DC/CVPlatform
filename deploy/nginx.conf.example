# CVPlatform 生产 Nginx 站点（脱敏模板）
#
# 用法：按实际域名与证书路径填写后保存为 /etc/nginx/sites-available/cvplatform，
# 再 sudo ln -s /etc/nginx/sites-available/cvplatform /etc/nginx/sites-enabled/，
# 最后 sudo nginx -t && sudo systemctl reload nginx。
#
# 要点：
# - 后端只监听 127.0.0.1:8000，公网一律经 Nginx 访问，不直接暴露 8000 端口；
# - 前端是 Vue Router history 模式，需要把未知路径回退到 index.html，否则刷新子路由会 404；
# - /api/ 代理要保留原始 Host 与真实客户端 IP（应用侧日志与限流都依赖它）。

server {
    listen 80;
    listen [::]:80;
    server_name 123.249.79.118;            # 有域名后替换为实际域名

    # 前端构建产物：发布时把 frontend/dist 的内容放到这个目录
    root /opt/cvplatform/frontend/dist;
    index index.html;

    # 静态资源长缓存：文件名带内容哈希，可以放心缓存一年
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 入口文件不缓存，保证发布后立即生效
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # 前端路由回退（刷新 /papers、/trends 等子路由不能 404）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 接口反向代理：只代理到本机后端
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 采集与批量导入会等待上游来源，超时留出余量
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    # 接口文档：联调期可开，正式对外可关掉
    location = /docs {
        proxy_pass http://127.0.0.1:8000/docs;
        proxy_set_header Host $host;
    }
    location /openapi.json {
        proxy_pass http://127.0.0.1:8000/openapi.json;
        proxy_set_header Host $host;
    }
}

