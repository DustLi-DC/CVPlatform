# CVPlatform 生产环境变量模板
#
# 用法：复制到服务器上的受限环境文件（例如 /etc/cvplatform.env），
# 由 systemd 通过 EnvironmentFile 读取。不要把这个文件填好真实值后提交到仓库。
#
#   sudo install -o root -g cvplatform -m 0640 deploy/env.example /etc/cvplatform.env
#   sudo editor /etc/cvplatform.env

# 运行环境：production 时数据库默认落在 /var/lib/cvplatform/cvplatform.db
CVPLATFORM_ENV=production

# 数据库绝对路径。留空则按 CVPLATFORM_ENV 取默认值；
# 生产环境建议显式写出，避免误用其他环境的默认路径。
CVPLATFORM_DB_PATH=/var/lib/cvplatform/cvplatform.db

# 出站请求并发与间隔（阶段 5/6 采集使用）。2 核 / 2Mbps 的小机器上保持低并发。
HTTP_CONCURRENCY=1
HTTP_INTERVAL_SECONDS=0.5

# 服务重启后是否自动续跑被中断的采集任务
AUTO_RESUME_TASKS=true

# 统计分组的默认口径：topic（主题归并）或 keyword（原始关键词）
STATS_DEFAULT_GROUP_BY=topic

# paper_keyword 保留的规则版本数（当前版本 + 历史版本）
KEYWORD_VERSION_KEEP=2

# 每个会议年份的抽样目标条数与单次导入上限
HARVEST_SAMPLE_LIMIT=200
IMPORT_MAX_ROWS=500
